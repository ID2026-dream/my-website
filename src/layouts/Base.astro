---
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/newsreader/opsz.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '../styles/global.css';
import Wave from '../components/Wave.astro';
import Icon from '../components/Icon.astro';
import PucaMark from '../components/PucaMark.astro';
import { SITE } from '../site.config';
import photo from '../assets/photo.jpg';
import { NAV_GROUPS } from '../data/nav';
import { url } from '../utils';

interface Props {
  title?: string;
  description?: string;
  heading?: string; // big title in the dark band (inner pages)
  icon?: string; // icon shown beside the heading; 'puca' shows the lab emblem
  lede?: string; // one line under the heading
}

const { title, description = SITE.description, heading, lede, icon } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.title}` : `${SITE.title}: ${SITE.role}`;
const canonical = new URL(Astro.url.pathname, Astro.site);

const groups = NAV_GROUPS.map((g) => ({
  heading: g.heading,
  items: g.items.map((i) => ({ ...i, href: url(i.path) })),
}));
const primary = groups.flatMap((g) => g.items).filter((i) => i.primary);

const here = Astro.url.pathname;
const isHere = (href: string) => here === href.split('#')[0];
---

<!doctype html>
<html lang="en-IE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {SITE.photo && <meta property="og:image" content={new URL(photo.src, Astro.site)} />}
    <meta name="generator" content={Astro.generator} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>

    <header class="band">
      <div class="wrap bar">
        <a class="brand" href={url('/')}>{SITE.name}</a>
        <nav class="primary" aria-label="Main">
          <ul>
            {primary.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={{ feature: item.feature }}
                  aria-current={isHere(item.href) ? 'page' : undefined}
                >
                  {item.feature && <PucaMark size={22} />}
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="menu-panel">
          <span class="when-closed">All pages</span><span class="when-open">Close</span>
        </button>
      </div>

      <nav id="menu-panel" class="wrap menu-panel" aria-label="All pages">
        {groups.map((g) => (
          <div class="menu-group">
            <p class="menu-heading">{g.heading}</p>
            <ul>
              {g.items.map((item) => (
                <li><a href={item.href} aria-current={isHere(item.href) ? 'page' : undefined}>{item.label}</a></li>
              ))}
            </ul>
          </div>
        ))}
        <div class="menu-group">
          <p class="menu-heading">Contact</p>
          <ul><li><a href="#contact">Address and links</a></li></ul>
        </div>
      </nav>

      <div class="wrap band-body">
        <slot name="hero">
          <div class="page-head">
            {icon && (
              <span class:list={['page-icon', { mark: icon === 'puca' }]}>
                {icon === 'puca' ? <PucaMark size={88} /> : <Icon name={icon} size={52} />}
              </span>
            )}
            <div>
              {heading && <h1>{heading}</h1>}
              {lede && <p class="band-lede">{lede}</p>}
            </div>
          </div>
        </slot>
      </div>
      <Wave />
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer id="contact">
      <div class="wrap footer-grid">
        <div>
          <h2>Contact</h2>
          <address>
            {SITE.address.map((line) => <span>{line}</span>)}
          </address>
          {SITE.email && <p><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>}
        </div>
        <div>
          <h2>Elsewhere</h2>
          <ul>
            {
              SITE.links.map((link) => (
                <li>
                  <a href={link.href} rel="me">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
      <p class="wrap small">© {new Date().getFullYear()} {SITE.name}</p>
    </footer>

    <script>
      const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const panel = document.getElementById('menu-panel');
      const setOpen = (open: boolean) => {
        toggle?.setAttribute('aria-expanded', String(open));
        panel?.classList.toggle('open', open);
      };
      toggle?.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
          setOpen(false);
          toggle.focus();
        }
      });
      panel?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    </script>
  </body>
</html>

<style>
  body {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  .skip {
    position: absolute;
    left: -999px;
  }

  .skip:focus {
    left: 0.75rem;
    top: 0.75rem;
    z-index: 10;
    padding: 0.5rem 0.75rem;
    background: var(--signal);
    color: var(--navy);
  }

  /* ---- Dark band ---- */
  .band {
    background: var(--navy);
    color: var(--on-navy);
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    padding-block: 1.25rem;
  }

  .brand {
    color: var(--on-navy);
    font-weight: 650;
    text-decoration: none;
    letter-spacing: -0.005em;
  }

  .primary ul {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary {
    margin-left: auto;
  }

  .primary a,
  .menu-panel a {
    color: var(--on-navy-muted);
    text-decoration: none;
  }

  .primary a {
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }

  .primary a:hover,
  .menu-panel a:hover {
    color: var(--on-navy);
  }

  .primary a[aria-current='page'] {
    color: var(--on-navy);
    border-bottom-color: var(--signal);
  }

  .menu-toggle {
    display: none;
    font: inherit;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--on-navy);
    background: none;
    border: 1px solid var(--navy-line);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    cursor: pointer;
  }

  .menu-toggle:hover {
    border-color: var(--signal);
  }

  .when-open,
  .menu-toggle[aria-expanded='true'] .when-closed {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] .when-open {
    display: inline;
  }

  /* The full menu. Without JavaScript it simply stays open. */
  .menu-panel {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 1.5rem 2rem;
    padding-block: 1.25rem 1.75rem;
    background: linear-gradient(var(--navy-line), var(--navy-line)) top center / calc(100% - 2 * var(--gutter)) 1px
      no-repeat;
  }

  :global(.js) .menu-toggle {
    display: inline-block;
  }

  :global(.js) .menu-panel:not(.open) {
    display: none;
  }

  .menu-heading {
    margin: 0 0 0.5rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--signal);
  }

  .menu-panel ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
  }

  .menu-panel a[aria-current='page'] {
    color: var(--on-navy);
    box-shadow: inset 0 -2px 0 var(--signal);
  }

  @media (max-width: 52rem) {
    .primary {
      display: none;
    }
  }

  .band-body {
    padding-top: clamp(1.5rem, 5vw, 3.5rem);
  }

  .page-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .page-icon {
    display: grid;
    place-items: center;
    width: 5.5rem;
    height: 5.5rem;
    flex: none;
    border-radius: 18px;
    color: var(--signal);
    background: color-mix(in srgb, var(--navy-line) 70%, transparent);
    border: 1px solid var(--navy-line);
    --icon-accent: #f0b14a;
  }

  .page-icon.mark {
    width: 7rem;
    height: 7rem;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--signal) 18%, transparent), transparent 70%);
    border: 0;
  }

  .primary a.feature {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.8rem 0.2rem 0.45rem;
    border: 1px solid var(--signal);
    border-radius: 999px;
    color: var(--on-navy);
  }

  .primary a.feature:hover,
  .primary a.feature[aria-current='page'] {
    background: color-mix(in srgb, var(--signal) 18%, transparent);
    border-bottom-color: var(--signal);
  }

  .band-body h1 {
    margin: 0;
    font-size: var(--step-3);
    color: var(--on-navy);
  }

  .band-lede {
    max-width: var(--measure);
    margin: 0.75rem 0 0;
    color: var(--on-navy-muted);
    font-size: var(--step-1);
    line-height: 1.45;
  }

  /* ---- Main and footer ---- */
  main {
    flex: 1;
    padding-block: clamp(2.5rem, 6vw, 4rem) clamp(3.5rem, 8vw, 5.5rem);
  }

  footer {
    background: var(--surface);
    border-top: 1px solid var(--rule);
    padding-block: 2.5rem 1.5rem;
  }

  .footer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
    gap: 2rem;
  }

  footer h2 {
    margin: 0 0 0.75rem;
    font-size: var(--step-1);
  }

  address {
    display: grid;
    font-style: normal;
    color: var(--muted);
  }

  footer p {
    margin: 0.75rem 0 0;
  }

  footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.25rem;
  }

  footer p.small {
    margin: 2rem auto 0;
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
