---
import Base from '../layouts/Base.astro';
import { MODULES } from '../data/teaching';
---

<Base
  title="Teaching"
  heading="Teaching"
  lede="Postgraduate teaching in artificial intelligence, built around hands-on labs."
>
  <div class="modules">
    {MODULES.map((m) => (
      <article class="panel module">
        <p class="level">{m.level}</p>
        <h2>{m.title}</h2>
        <p>{m.summary}</p>
        <ul class="facts">
          {m.facts.map((f) => <li>{f}</li>)}
        </ul>
        {m.href && <a class="go" href={m.href}>{m.linkLabel ?? 'Course page'}</a>}
      </article>
    ))}
  </div>
</Base>

<style>
  .modules {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 26rem), 1fr));
    gap: 1rem;
  }

  .module {
    padding: 1.5rem;
    border-top: 4px solid var(--link);
  }

  .level {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--link);
  }

  h2 {
    margin: 0.25rem 0 0.75rem;
    font-size: var(--step-2);
  }

  p {
    margin: 0 0 1rem;
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0 0 1.25rem;
    padding: 0;
    list-style: none;
  }

  .facts li {
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
    background: var(--paper);
    border: 1px solid var(--rule);
    font-size: var(--step--1);
  }

  .go {
    font-weight: 600;
  }
</style>
