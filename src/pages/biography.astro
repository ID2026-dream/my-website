---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import { SITE } from '../site.config';
import { url } from '../utils';

const more = [
  { label: 'Career and qualifications', href: url('/career/') },
  { label: 'Awards and distinctions', href: url('/awards/') },
  { label: 'Research themes and projects', href: url('/research/') },
  { label: SITE.lab.name, href: url('/lab/') },
  { label: 'Supervision', href: url('/supervision/') },
  { label: 'Service', href: url('/service/') },
  { label: 'Outreach', href: url('/outreach/') },
];
---

<Base
  icon="person"
  title="Biography"
  heading="Biography"
  lede="Trustworthy, data-efficient AI for complex systems, built on a career across Canada, Norway and Ireland."
>
  <div class="layout">
    <div class="bio">
      <p>
        Dr Indrakshi Dey has been a Lecturer in Computer Science in the Department of Computing and Mathematics at South
        East Technological University (SETU) in Waterford, Ireland, since 2023. She is also a Funded Investigator with
        CONNECT, the Research Ireland Centre for Future Networks, and an Adjunct Assistant Professor at Trinity College
        Dublin. She leads {SITE.lab.name}, her research group at SETU.
      </p>
      <p>
        Her research builds trustworthy, data-efficient artificial intelligence platforms for complex systems, from
        networks to human health, at the intersection of wireless communications, dynamical systems and number theory.
        She has published 45 peer-reviewed journal papers and 36 conference papers, alongside four research monographs
        and seven book chapters, holds three granted patents, and received the Best Paper Award at IEEE ICC 2026.
      </p>
      <p>
        Her career has taken her across three research cultures. Her PhD at the University of Calgary (2015) challenged
        rigid stochastic models of wireless propagation. As a Research Fellow at Defence Research and Development Canada
        she hardened signal processing for waveform-level security in underwater acoustic channels; as an ERCIM Fellow
        at NTNU she pioneered wideband collaborative spectrum sensing using massive MIMO decision fusion; and as a Marie
        Skłodowska-Curie EDGE Fellow at Trinity College Dublin she combined quantum game theory with network topology.
        She was then a Lecturer at Maynooth University from 2019 to 2022, before joining SETU.
      </p>
      <p>
        She coordinates the QUESTING MSCA Doctoral Network and the Horizon Europe project Q-FENCE, coordinated COALESCE,
        and leads SETU’s contribution to ENACT. She is an Expert Reviewer for the Horizon Europe Excellence Pillar, an
        elected Committee Member of the IEEE Future Networks UK and Ireland Local Group and a Senior Member of IEEE.
        Since 2018 she has been a Senior Mentor with TeenTurn, and she is lead judge at the All-Ireland SciFest and
        Academic Champion of the Trinity Walton Club.
      </p>
    </div>

    <aside class="facts">
      <div class="panel card">
        <Portrait size={96} />
        <p class="name">{SITE.title}</p>
        <p class="role">{SITE.role}</p>
        <p class="org">{SITE.affiliation}</p>
      </div>
      <nav aria-labelledby="more">
        <h2 id="more">More about Indrakshi</h2>
        <ul class="more">
          {more.map((m) => <li><a href={m.href}>{m.label}</a></li>)}
        </ul>
      </nav>
    </aside>
  </div>
</Base>

<style>
  .layout {
    display: grid;
    grid-template-columns: minmax(0, var(--measure)) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
  }

  @media (max-width: 60rem) {
    .layout {
      grid-template-columns: 1fr;
    }
  }

  .bio {
    font-family: var(--display);
    font-size: 1.25rem;
    line-height: 1.65;
  }

  .bio p {
    margin: 0 0 1.1em;
  }

  .facts {
    display: grid;
    gap: 2rem;
  }

  .card {
    padding: 1.5rem;
    text-align: center;
    display: grid;
    justify-items: center;
    gap: 0.25rem;
  }

  .card p {
    margin: 0;
  }

  .name {
    margin-top: 0.75rem !important;
    font-family: var(--display);
    font-size: var(--step-1);
  }

  .role,
  .org {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .facts h2 {
    margin: 0 0 0.75rem;
    font-size: var(--step-1);
  }

  .more {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .more li {
    padding-block: 0.55rem;
    border-top: 1px solid var(--rule);
  }

  .more li:last-child {
    border-bottom: 1px solid var(--rule);
  }
</style>
