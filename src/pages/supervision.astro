---
import SiteLink from '../components/SiteLink.astro';
import Base from '../layouts/Base.astro';
import TeamPhoto from '../components/TeamPhoto.astro';
import { projectId } from '../data/projects';
import { url } from '../utils';
import {
  TEAM,
  TEAM_GROUPS,
  SUPERVISION_SUMMARY as SUM,
  isCurrent,
  isIncoming,
  isFormer,
  tenure,
} from '../data/profile';

const groups = TEAM_GROUPS.map((g) => ({
  ...g,
  members: [
    ...TEAM.filter((m) => m.group === g.id && isCurrent(m)),
    ...TEAM.filter((m) => m.group === g.id && isIncoming(m)),
  ],
})).filter((g) => g.members.length);
const former = [...TEAM.filter((m) => m.graduated), ...TEAM.filter((m) => isFormer(m) && !m.graduated)];
const oneOf = (id: string) => TEAM_GROUPS.find((g) => g.id === id)!.one;
const lines = (...xs: (string | undefined | false)[]) => xs.filter(Boolean) as string[];
---

<Base
  icon="users-three"
  title="Supervision"
  heading="Supervision"
  lede="PhD students, Masters by Research students and postdoctoral fellows at SETU and partner universities."
>
  <section class="summary panel" aria-label="Supervision at a glance">
    <ul>
      <li><strong data-count={SUM.currentPhd}>{SUM.currentPhd}</strong> current PhD students</li>
      <li>
        <strong data-count={SUM.currentMasters}>{SUM.currentMasters}</strong>{' '}
        {SUM.currentMasters === 1 ? 'Masters by Research student' : 'Masters by Research students'}
      </li>
      <li><strong data-count={SUM.currentPostdocs}>{SUM.currentPostdocs}</strong> postdoctoral fellows</li>
      <li><strong data-count={SUM.graduatedPhd}>{SUM.graduatedPhd}</strong> PhD graduates</li>
    </ul>
    <p>{SUM.note} {SUM.topics}</p>
  </section>

  {
    groups.map((g) => (
      <section class="group" aria-labelledby={`g-${g.id}`}>
        <h2 id={`g-${g.id}`}>{g.members.length === 1 ? g.one : g.label}</h2>
        <ul>
          {g.members.map((m) => (
            <li class="person">
              <TeamPhoto name={m.name} size={64} />
              <div>
                <h3>{m.links?.length ? <a href={m.links[0].href}>{m.name}</a> : m.name}</h3>
                {m.topic && <p class="topic">{m.topic}</p>}
                <p class="meta">
                  {lines(m.institution, m.role, tenure(m)).map((line, i) => (
                    <>
                      {i > 0 && <br />}
                      {line}
                    </>
                  ))}
                </p>
                {(m.projects?.length || m.funding) && (
                  <p class="meta">
                    {m.projects?.length ? (
                      <>
                        {m.projects.length > 1 ? 'Projects: ' : 'Project: '}
                        {m.projects.map((name, i) => (
                          <>
                            {i > 0 && ', '}
                            <a href={url(`/research/#${projectId(name)}`)}>{name}</a>
                          </>
                        ))}
                      </>
                    ) : (
                      `Funded by ${m.funding}`
                    )}
                  </p>
                )}
                {m.note && <p>{m.note}</p>}
                {m.links && m.links.length > 0 && (
                  <p class="links">
                    {m.links.map((l) => (
                      <SiteLink href={l.href}>{l.label}</SiteLink>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    former.length > 0 && (
      <section class="group" aria-labelledby="g-former">
        <h2 id="g-former">Graduates and former members</h2>
        <ul>
          {former.map((m) => (
            <li class="person">
              <TeamPhoto name={m.name} size={64} />
              <div>
                <h3>{m.links?.length ? <a href={m.links[0].href}>{m.name}</a> : m.name}</h3>
                {m.topic && <p class="topic">{m.topic}</p>}
                <p class="meta">
                  {lines(
                    [m.graduated ? 'PhD' : oneOf(m.group), tenure(m)].filter(Boolean).join(', '),
                    m.institution,
                    m.role,
                  ).map(
                    (line, i) => (
                      <>
                        {i > 0 && <br />}
                        {line}
                      </>
                    ),
                  )}
                </p>
                {m.funding && <p class="meta">Funded by {m.funding}</p>}
                {m.note && <p>{m.note}</p>}
                <p>
                  {m.graduated
                    ? typeof m.graduated === 'string'
                      ? `Thesis defended in ${m.graduated}.`
                      : 'Thesis defended.'
                    : m.departed!.destination}
                </p>
                {m.links && m.links.length > 0 && (
                  <p class="links">
                    {m.links.map((l) => (
                      <SiteLink href={l.href}>{l.label}</SiteLink>
                    ))}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>

<style>
  .summary {
    padding: 1.25rem 1.5rem;
    margin-bottom: 3rem;
    max-width: 48rem;
  }

  .summary ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 2rem;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
  }

  .summary li {
    padding: 0;
    border: 0;
  }

  .summary strong {
    font-family: var(--display);
    font-size: var(--step-2);
    font-weight: 560;
    margin-right: 0.3rem;
  }

  .summary p {
    color: var(--muted);
  }

  .group + .group {
    margin-top: 3rem;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: var(--step-2);
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 48rem;
  }

  li {
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  h3 {
    margin: 0;
    font-size: var(--step-1);
  }

  p {
    margin: 0.35rem 0 0;
    max-width: var(--measure);
  }

  .topic {
    font-weight: 600;
  }

  .meta {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .person {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
  }

  .person > div {
    min-width: 0;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    font-size: 0.9375rem;
  }
</style>
