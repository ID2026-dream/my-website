---
import Base from '../layouts/Base.astro';
import Portrait from '../components/Portrait.astro';
import PucaMark from '../components/PucaMark.astro';
import ThemeCard from '../components/ThemeCard.astro';
import PubItem from '../components/PubItem.astro';
import { SITE } from '../site.config';
import { THEMES } from '../data/themes';
import { PUBLICATIONS, PUB_STATS } from '../data/publications';
import { PROJECTS } from '../data/projects';
import { MODULES } from '../data/teaching';
import { SUPERVISION_SUMMARY as SUM } from '../data/profile';
import { url } from '../utils';

const countFor = (id: string) => PUBLICATIONS.filter((p) => p.themes.includes(id as never)).length;
const recent = PUBLICATIONS.filter((p) => p.type === 'journal' || p.type === 'conference').slice(0, 5);
// Projects Dr Dey leads, coordinated ones first.
const leading = PROJECTS.filter(
  (p) => p.tier !== 'other' && /^(Coordinator|Principal Investigator|Leads)/.test(p.role ?? ''),
)
  .sort((a, b) => Number(b.role === 'Coordinator') - Number(a.role === 'Coordinator'))
  .slice(0, 4);
---

<Base>
  <div slot="hero" class="hero">
    <Portrait size={136} />
    <div>
      <h1>{SITE.title}</h1>
      <p class="role">{SITE.role}</p>
      <p class="org">{SITE.affiliation}, {SITE.location}</p>
      <ul class="links">
        <li>
          <a class="lab-pill" href={url('/lab/')}><PucaMark size={22} />{SITE.lab.name}</a>
        </li>
        {
          SITE.links.slice(0, 4).map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
        {SITE.email && <li><a href={`mailto:${SITE.email}`}>Email</a></li>}
      </ul>
    </div>
  </div>

  <section class="intro">
    <p class="lede">{SITE.intro}</p>
    <p>
      She leads <a href={url('/lab/')}>{SITE.lab.name}</a>, her research group at SETU, and leads European
      projects including the QUESTING doctoral network and Q-FENCE. Her work received the IEEE ICC 2026 Best Paper
      Award. <a href={url('/biography/')}>Read her full biography</a>.
    </p>
  </section>

  <section class="puca-band section" aria-labelledby="puca-title">
    <div class="puca-art">
      <PucaMark size={220} label={`${SITE.lab.name} emblem: a hare drawn as a network`} />
    </div>
    <div class="puca-text">
      <h2 id="puca-title">{SITE.lab.name}</h2>
      <p class="puca-tag">{SITE.lab.tagline}</p>
      <p>
        Dr Dey’s research group at SETU builds trustworthy, data-efficient AI for complex systems. Like the
        shape-shifting púca of Irish folklore, our networks, protocols and AI platforms change form under stress but
        keep doing their job.
      </p>
      <ul class="puca-facts">
        <li><strong data-count={SUM.currentPhd}>{SUM.currentPhd}</strong> PhD students</li>
        <li><strong data-count={SUM.currentPostdocs}>{SUM.currentPostdocs}</strong> postdoctoral fellows</li>
        <li><strong data-count={THEMES.length}>{THEMES.length}</strong> research themes</li>
      </ul>
      <a class="puca-cta" href={url('/lab/')}>Visit {SITE.lab.name}</a>
    </div>
  </section>

  <section class="section" aria-labelledby="themes">
    <div class="section-head">
      <h2 id="themes">Research themes</h2>
      <a href={url('/research/')}>More about the research</a>
    </div>
    <div class="grid">
      {THEMES.map((theme) => <ThemeCard theme={theme} count={countFor(theme.id)} />)}
    </div>
  </section>

  <div class="split section">
    <section aria-labelledby="pubs">
      <div class="section-head">
        <h2 id="pubs">Recent publications</h2>
        <a href={url('/publications/')}>All publications</a>
      </div>
      <ul class="pubs">
        {recent.map((pub) => <PubItem pub={pub} showYear />)}
      </ul>
      <p class="note">{PUB_STATS.slice(0, 4).map((st) => `${st.value} ${st.label}`).join(', ')} since 2011.</p>
    </section>

    <aside>
      <section class="panel side" aria-labelledby="project">
        <h2 id="project">Leading</h2>
        <ul class="leading">
          {leading.map((p) => (
            <li>
              <p class="side-title">{p.name}</p>
              <p class="side-meta">{p.role!.split(';')[0]}, {p.funder.replace(/ \(.*\)$/, '')}</p>
            </li>
          ))}
        </ul>
        <a href={url('/research/#projects')}>All projects</a>
      </section>

      <section class="panel side" aria-labelledby="teaching">
        <h2 id="teaching">Teaching</h2>
        {
          MODULES.map((m) => (
            <>
              <p class="side-title">{m.title}</p>
              <p class="side-meta">{m.level} module, {m.facts.join(', ').toLowerCase()}</p>
              {m.href && <a href={m.href}>{m.linkLabel ?? 'Course page'}</a>}
            </>
          ))
        }
      </section>
    </aside>
  </div>
</Base>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2rem;
  }

  .hero h1 {
    margin: 0 0 0.5rem;
    font-size: var(--step-4);
    font-weight: 520;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--on-navy);
  }

  .role {
    margin: 0;
    font-size: var(--step-1);
    color: var(--on-navy);
  }

  .org {
    margin: 0.15rem 0 0;
    color: var(--on-navy-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: inline-block;
    padding: 0.25rem 0.8rem;
    border: 1px solid var(--navy-line);
    border-radius: 999px;
    color: var(--on-navy);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }

  .links a:hover {
    border-color: var(--signal);
  }

  .lab-pill {
    display: inline-flex !important;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0.85rem 0.2rem 0.45rem !important;
    background: var(--signal);
    border-color: var(--signal) !important;
    color: var(--navy) !important;
  }

  .lab-pill:hover {
    background: #8ae3db;
  }

  .lab-pill :global(.puca polygon) {
    fill: var(--navy);
  }

  .puca-band {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem clamp(2rem, 5vw, 4rem);
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: 20px;
    color: var(--on-navy);
    background:
      radial-gradient(circle at 18% 50%, color-mix(in srgb, var(--signal) 22%, transparent), transparent 16rem),
      var(--navy);
  }

  @media (max-width: 44rem) {
    .puca-band {
      grid-template-columns: 1fr;
      justify-items: start;
    }

    .puca-art :global(svg) {
      width: 150px;
      height: auto;
    }
  }

  .puca-band h2 {
    margin: 0;
    font-size: var(--step-3);
    color: var(--on-navy);
  }

  .puca-tag {
    margin: 0.4rem 0 1rem;
    font-family: var(--display);
    font-style: italic;
    font-size: var(--step-1);
    color: var(--signal);
  }

  .puca-text > p:not(.puca-tag) {
    max-width: var(--measure);
    margin: 0;
    color: var(--on-navy-muted);
  }

  .puca-facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 1.25rem 0 1.5rem;
    padding: 0;
    list-style: none;
    color: var(--on-navy-muted);
  }

  .puca-facts strong {
    font-family: var(--display);
    font-size: var(--step-2);
    font-weight: 520;
    color: var(--on-navy);
    margin-right: 0.3rem;
  }

  .puca-cta {
    display: inline-block;
    padding: 0.6rem 1.2rem;
    border-radius: 999px;
    background: var(--signal);
    color: var(--navy);
    font-weight: 650;
    text-decoration: none;
  }

  .puca-cta:hover {
    background: #8ae3db;
  }

  .puca-cta:focus-visible {
    outline-color: var(--signal);
  }

  .intro p {
    margin: 0;
    max-width: var(--measure);
  }

  .intro p + p {
    margin-top: 1rem;
    color: var(--muted);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 20rem;
    gap: 2.5rem;
    align-items: start;
  }

  @media (max-width: 60rem) {
    .split {
      grid-template-columns: 1fr;
    }
  }

  .pubs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .note {
    margin: 0;
    padding-top: 0.9rem;
    border-top: 1px solid var(--rule);
    font-size: var(--step--1);
    color: var(--muted);
  }

  aside {
    display: grid;
    gap: 1rem;
  }

  .side {
    padding: 1.25rem;
  }

  .side h2 {
    margin: 0 0 0.75rem;
    font-size: var(--step-1);
  }

  .side p {
    margin: 0 0 0.75rem;
  }

  .side-title {
    font-weight: 650;
    margin-bottom: 0.1rem !important;
  }

  .side-meta {
    font-size: var(--step--1);
    color: var(--muted);
  }

  .leading {
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
  }

  .leading li + li {
    margin-top: 0.6rem;
  }

  .leading p {
    margin: 0 !important;
  }
</style>
