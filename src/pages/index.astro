---
import Base from '../layouts/Base.astro';
import ProjectList from '../components/ProjectList.astro';
import PostList from '../components/PostList.astro';
import { SITE } from '../site.config';
import { getPosts, getProjects } from '../lib/content';
import { formatDate, url } from '../utils';

const featured = (await getProjects()).filter((p) => p.data.featured);
const recentPosts = (await getPosts()).slice(0, 3);
---

<Base>
  <section class="hero">
    <h1>{SITE.name}</h1>
    <p class="intro">{SITE.intro}</p>
    <p class="now">
      {SITE.now}{' '}
      <span class="updated">Updated {formatDate(new Date(SITE.nowUpdated))}.</span>
    </p>
  </section>

  <section aria-labelledby="work">
    <div class="section-head">
      <h2 id="work">Selected work</h2>
      <a class="mark" href={url('/projects/')}>See all work</a>
    </div>
    <ProjectList projects={featured} />
  </section>

  <section aria-labelledby="writing">
    <div class="section-head">
      <h2 id="writing">Writing</h2>
      <a class="mark" href={url('/blog/')}>See all posts</a>
    </div>
    <PostList posts={recentPosts} />
  </section>
</Base>

<style>
  h1 {
    margin: 0 0 0.25em -0.03em; /* the negative left margin optically aligns the big letters with the text below */
    font-size: var(--step-hero);
    font-weight: 800;
    line-height: 0.88;
    letter-spacing: -0.055em;
  }

  .intro {
    max-width: 30ch;
    margin: 0;
    font-size: clamp(1.375rem, 3vw, 1.875rem);
    line-height: 1.3;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .now {
    max-width: var(--measure);
    margin: 1.5rem 0 0;
    color: var(--muted);
  }

  .updated {
    font-size: var(--step--1);
    white-space: nowrap;
  }

  section + section {
    margin-top: clamp(3.5rem, 9vw, 6rem);
  }

  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25rem 1.5rem;
    margin-bottom: 1rem;
  }

  h2 {
    margin: 0;
    font-size: var(--step-2);
  }

  .section-head a {
    color: var(--muted);
  }
</style>
