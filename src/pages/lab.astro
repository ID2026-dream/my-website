---
import Base from '../layouts/Base.astro';
import ThemeCard from '../components/ThemeCard.astro';
import PucaMark from '../components/PucaMark.astro';
import TeamPhoto from '../components/TeamPhoto.astro';
import Portrait from '../components/Portrait.astro';
import { SITE } from '../site.config';
import { THEMES } from '../data/themes';
import { PUBLICATIONS } from '../data/publications';
import { TEAM, TEAM_GROUPS, SUPERVISION_SUMMARY as SUM, isCurrent, isIncoming, tenure } from '../data/profile';
import { url } from '../utils';

const countFor = (id: string) => PUBLICATIONS.filter((p) => p.themes.includes(id as never)).length;
const { lab } = SITE;

const groups = TEAM_GROUPS.map((g) => ({
  ...g,
  members: [
    ...TEAM.filter((m) => m.group === g.id && isCurrent(m)),
    ...TEAM.filter((m) => m.group === g.id && isIncoming(m)),
  ],
})).filter((g) => g.members.length);
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
---

<Base title={lab.name} description={`${lab.name}: ${lab.tagline} Dr Indrakshi Dey’s research group at South East Technological University.`}>
  <div slot="hero" class="lab-hero">
    <div>
      <h1>{lab.name}</h1>
      <p class="tag">{lab.tagline}</p>
      <p class="sub">Dr Indrakshi Dey’s research group, South East Technological University</p>
    </div>
    <div class="emblem">
      <PucaMark size={240} label={`${lab.name} emblem: a hare drawn as a network`} />
    </div>
  </div>

  <section class="intro">
    <p class="lede">
      {lab.name} is Dr Indrakshi Dey’s research group in the Department of Computing and Mathematics at South East
      Technological University. We build trustworthy, data-efficient AI platforms for complex systems, from the physics
      of the wireless channel to networks and human health.
    </p>
    <p class="meaning"><strong>Why the name?</strong> {lab.meaning}</p>
    <p>
      Open research is standard practice in the group: outputs are released as preprints with persistent identifiers,
      code is open-sourced under permissive licences, and protocols are documented so that results can be reproduced.
    </p>
  </section>

  <section class="section" aria-labelledby="themes">
    <div class="section-head">
      <h2 id="themes">What we work on</h2>
      <a href={url('/research/#projects')}>Our projects</a>
    </div>
    <div class="grid">
      {THEMES.map((theme) => <ThemeCard theme={theme} count={countFor(theme.id)} />)}
    </div>
  </section>

  <section class="section people" aria-labelledby="people">
    <div class="section-head">
      <h2 id="people">People</h2>
      <a href={url('/supervision/')}>Supervision</a>
    </div>
    <p class="count">
      Dr Dey currently supervises {plural(SUM.currentPhd, 'PhD student', 'PhD students')},{' '}
      {plural(SUM.currentMasters, 'Masters by Research student', 'Masters by Research students')} and{' '}
      {plural(SUM.currentPostdocs, 'postdoctoral fellow', 'postdoctoral fellows')}, and has graduated{' '}
      {plural(SUM.graduatedPhd, 'PhD student', 'PhD students')}.
    </p>
    <div class="pi">
      <Portrait size={64} />
      <div>
        <h3>Dr Indrakshi Dey</h3>
        <p class="topic">Principal Investigator</p>
      </div>
    </div>
    {
      groups.map((g) => (
        <div class="team-group">
          <h3 class="group-title">{g.members.length === 1 ? g.one : g.label}</h3>
          <ul>
            {g.members.map((m) => (
              <li>
                <TeamPhoto name={m.name} size={48} />
                <div>
                  <p class="name">{m.links?.length ? <a href={m.links[0].href}>{m.name}</a> : m.name}</p>
                  {m.topic && <p class="what">{m.topic}</p>}
                  {[m.institution, m.role, isIncoming(m) && tenure(m)].filter(Boolean).map((line) => (
                    <p class="where">{line}</p>
                  ))}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <section class="section panel join" aria-labelledby="join">
    <h2 id="join">Join or work with us</h2>
    <p>
      For research collaboration, industry projects or PhD and postdoctoral enquiries, email{' '}
      <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
    </p>
  </section>
</Base>

<style>
  .lab-hero {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .lab-hero h1 {
    margin: 0;
    font-size: var(--step-4);
    font-weight: 520;
    letter-spacing: -0.02em;
    line-height: 1;
    color: var(--on-navy);
  }

  .tag {
    margin: 0.75rem 0 0;
    font-family: var(--display);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--signal);
  }

  .sub {
    margin: 0.5rem 0 0;
    color: var(--on-navy-muted);
  }

  .emblem {
    display: grid;
    place-items: center;
    width: 17rem;
    height: 14rem;
    background: radial-gradient(circle, color-mix(in srgb, var(--signal) 20%, transparent), transparent 68%);
  }

  @media (max-width: 44rem) {
    .emblem {
      width: 12rem;
      height: 10rem;
    }

    .emblem :global(svg) {
      width: 160px;
      height: auto;
    }
  }

  .intro p {
    margin: 0;
    max-width: var(--measure);
  }

  .intro p + p {
    margin-top: 1rem;
    color: var(--muted);
  }

  .meaning strong {
    color: var(--ink);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
  }

  .section-head h2,
  .join h2 {
    margin: 0;
    font-size: var(--step-2);
  }

  .count {
    margin: 0 0 1rem;
    max-width: var(--measure);
    color: var(--muted);
  }

  .pi {
    display: flex;
    gap: 1rem;
    align-items: center;
    max-width: 48rem;
    padding-block: 1rem;
    border-block: 1px solid var(--rule);
  }

  .pi h3 {
    margin: 0 0 0.2rem;
    font-size: var(--step-1);
  }

  .pi p {
    margin: 0;
  }

  .team-group {
    margin-top: 2rem;
  }

  .group-title {
    margin: 0 0 0.5rem;
    font-family: var(--sans);
    font-size: var(--step-0);
    font-weight: 650;
    color: var(--muted);
  }

  .team-group ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr));
    gap: 0 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .team-group li {
    display: flex;
    gap: 0.85rem;
    align-items: flex-start;
    padding-block: 0.85rem;
    border-top: 1px solid var(--rule);
  }

  .team-group li > div {
    min-width: 0;
  }

  .what {
    margin: 0.2rem 0 0;
    font-size: 0.875rem;
    line-height: 1.4;
  }

  .name {
    margin: 0;
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 520;
    line-height: 1.25;
  }

  .where {
    margin: 0.15rem 0 0;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .topic {
    color: var(--muted);
  }

  .join {
    padding: 1.5rem;
  }

  .join h2 {
    margin-bottom: 0.75rem;
  }

  .join p {
    margin: 0;
    max-width: var(--measure);
  }
</style>
