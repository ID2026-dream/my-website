---
import Base from '../layouts/Base.astro';
import { url } from '../utils';
---

<Base title="Page not found">
  <h1>Nothing lives at this address.</h1>
  <p>The page may have moved, or the link has a typo. Start again from the <a class="mark" href={url('/')}>home page</a>.</p>
</Base>

<style>
  h1 {
    max-width: 16ch;
    margin: 0 0 1rem;
    font-size: var(--step-3);
    font-weight: 800;
    letter-spacing: -0.035em;
  }

  p {
    font-size: var(--step-1);
    color: var(--muted);
  }

  a {
    color: var(--ink);
  }
</style>
