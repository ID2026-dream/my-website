---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import PubItem from '../components/PubItem.astro';
import { THEMES } from '../data/themes';
import { PUBLICATIONS } from '../data/publications';
import { PORTFOLIO, PROJECTS, projectId } from '../data/projects';
import { TEAM, isCurrent, isIncoming } from '../data/profile';
import { url } from '../utils';

// For each theme: three recent papers (journal articles first), and the total count.
const rank = { journal: 0, conference: 1, chapter: 2, thesis: 3, preprint: 4 } as const;
const themes = THEMES.map((theme) => {
  const all = PUBLICATIONS.filter((p) => p.themes.includes(theme.id));
  const examples = all
    .filter((p) => p.type !== 'preprint' && !p.venue.endsWith('…'))
    .sort((a, b) => b.year - a.year || rank[a.type] - rank[b.type])
    .slice(0, 3);
  return { theme, count: all.length, examples };
});

const major = PROJECTS.filter((p) => p.tier !== 'other');
const other = PROJECTS.filter((p) => p.tier === 'other');
// Current and incoming lab members working on each project.
const teamOn = (name: string) =>
  TEAM.filter((m) => (isCurrent(m) || isIncoming(m)) && m.projects?.includes(name)).map((m) => m.name);
---

<Base
  title="Research"
  icon="flask"
  heading="Research"
  lede="Trustworthy, data-efficient AI for complex systems, from the physics of the wireless channel to networks and human health."
>
  <nav class="jump" aria-label="Themes on this page">
    <ul>
      {themes.map(({ theme }) => (
        <li style={`--c:${theme.color}`}>
          <a href={`#${theme.id}`}><Icon name={theme.icon} size={18} animate="none" />{theme.title}</a>
        </li>
      ))}
      <li style="--c: var(--ink)"><a href="#projects">Projects</a></li>
    </ul>
  </nav>

  {themes.map(({ theme, count, examples }) => (
    <section class="theme" id={theme.id} style={`--c:${theme.color}`} aria-labelledby={`${theme.id}-title`}>
      <div class="theme-text">
        <span class="icon hover-anim" style={`--icon-accent:${theme.color === '#b86e0b' ? '#0b8783' : '#e9a23b'}`}><Icon name={theme.icon} size={52} /></span>
        <h2 id={`${theme.id}-title`}>{theme.title}</h2>
        <p>{theme.description}</p>
        <a class="all" href={url(`/publications/?theme=${theme.id}`)}>See all {count} publications</a>
      </div>
      <div>
        <h3 class="visually-hidden">Selected papers</h3>
        <ul class="pubs">
          {examples.map((pub) => <PubItem pub={pub} showYear />)}
        </ul>
      </div>
    </section>
  ))}

  <section id="projects" class="projects" aria-labelledby="projects-title">
    <h2 id="projects-title">Projects</h2>
    <p class="portfolio">{PORTFOLIO}</p>
    <div class="project-list">
      {major.map((p) => (
        <article
          id={projectId(p.name)}
          class="panel project hover-anim"
          style={`--c:${p.color};--icon-accent:${p.color === '#b86e0b' ? '#0b8783' : '#e9a23b'}`}
        >
          <span class="picon"><Icon name={p.icon} size={44} /></span>
          <h3>{p.name}</h3>
          {p.fullName && <p class="full">{p.fullName}</p>}
          {p.role && <p class="role">{p.role}</p>}
          <p class="meta">{p.funder}{p.period && <><br />{p.period}</>}</p>
          <p>{p.summary}</p>
          {teamOn(p.name).length > 0 && (
            <p class="team">
              <span>From the lab:</span> {teamOn(p.name).join(', ')}
            </p>
          )}
          {p.links && p.links.length > 0 && (
            <p class="plinks">
              {p.links.map((l) => (
                <a href={l.href}>{l.label}</a>
              ))}
            </p>
          )}
        </article>
      ))}
    </div>
    {
      other.length > 0 && (
        <>
          <h3 class="other-title">Other funded projects</h3>
          <ul class="other">
            {other.map((p) => (
              <li id={projectId(p.name)}>
                <p class="oname">
                  <strong>{p.name}</strong>
                  {p.fullName && <span>{p.fullName}</span>}
                </p>
                <p>{p.summary}</p>
                <p class="meta">
                  {p.funder}
                  {p.period && <>, {p.period.charAt(0).toLowerCase() + p.period.slice(1)}</>}
                </p>
              </li>
            ))}
          </ul>
        </>
      )
    }
  </section>
</Base>

<style>
  .jump ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
  }

  .jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.8rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink);
    font-size: var(--step--1);
    font-weight: 600;
    text-decoration: none;
  }

  .jump a:hover {
    border-color: var(--c);
  }

  .jump :global(svg) {
    color: var(--c);
  }

  .theme {
    display: grid;
    grid-template-columns: minmax(0, 24rem) minmax(0, 1fr);
    gap: 1.5rem clamp(2rem, 5vw, 4rem);
    padding-block: 2.5rem;
    border-top: 1px solid var(--rule);
  }

  .theme:first-of-type {
    border-top: 0;
  }

  @media (max-width: 56rem) {
    .theme {
      grid-template-columns: 1fr;
    }
  }

  .icon {
    display: grid;
    place-items: center;
    width: 5rem;
    height: 5rem;
    border-radius: 16px;
    color: var(--c);
    background: color-mix(in srgb, var(--c) 11%, white);
  }

  .theme h2 {
    margin: 0.9rem 0 0.6rem;
    font-size: var(--step-2);
  }

  .theme-text p {
    margin: 0 0 0.9rem;
    color: var(--muted);
  }

  .all {
    font-weight: 600;
    color: var(--c);
  }

  .pubs {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .pubs :global(.pub:first-child) {
    border-top: 0;
    padding-top: 0;
  }

  .projects {
    margin-top: 2rem;
    padding-top: 2.5rem;
    border-top: 1px solid var(--rule);
  }

  .projects h2 {
    margin: 0 0 1.25rem;
    font-size: var(--step-2);
  }

  .project-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
    gap: 1rem;
    align-items: start;
  }

  .project {
    padding: 1.25rem;
    border-top: 4px solid var(--c);
  }

  .picon {
    display: grid;
    place-items: center;
    width: 4rem;
    height: 4rem;
    margin-bottom: 0.9rem;
    border-radius: 14px;
    color: var(--c);
    background: linear-gradient(135deg, color-mix(in srgb, var(--c) 16%, white), color-mix(in srgb, var(--c) 5%, white));
  }

  .project h3 {
    margin: 0;
    font-size: var(--step-1);
  }

  .project p {
    margin: 0 0 0.75rem;
  }

  .full {
    color: var(--muted);
  }

  .role {
    margin-top: 0.4rem !important;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--link);
  }

  .portfolio {
    max-width: var(--measure);
    margin: -0.5rem 0 1.5rem;
    color: var(--muted);
  }

  .meta {
    font-size: var(--step--1);
    color: var(--muted);
    margin-top: 0.1rem !important;
  }

  .project a {
    font-weight: 600;
  }

  .project {
    scroll-margin-top: 1.5rem;
  }

  .plinks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.25rem;
    margin-bottom: 0 !important;
  }

  .team {
    font-size: var(--step--1);
  }

  .team span {
    font-weight: 600;
  }

  .other-title {
    margin: 2.5rem 0 0.5rem;
    font-size: var(--step-1);
  }

  .other {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: 0 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .other li {
    padding-block: 0.9rem;
    border-top: 1px solid var(--rule);
    scroll-margin-top: 1.5rem;
  }

  .other p {
    margin: 0.2rem 0 0;
    max-width: var(--measure);
  }

  .oname strong {
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 560;
  }

  .oname span {
    display: block;
    color: var(--muted);
  }
</style>
