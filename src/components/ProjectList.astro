---
import type { CollectionEntry } from 'astro:content';

interface Props {
  projects: CollectionEntry<'projects'>[];
}

const { projects } = Astro.props;
---

<ul class="projects">
  {
    projects.map(({ data }) => {
      const href = data.url ?? data.repo;
      return (
        <li>
          <span class="year">{data.year}</span>
          <div>
            <h3>
              {href ? (
                <a class="mark" href={href}>
                  {data.title}
                </a>
              ) : (
                data.title
              )}
            </h3>
            <p>{data.description}</p>
            {(data.tools.length > 0 || (data.url && data.repo)) && (
              <p class="meta">
                {data.tools.length > 0 && <span>{data.tools.join(', ')}</span>}
                {data.url && data.repo && (
                  <a class="mark" href={data.repo}>
                    Source code
                  </a>
                )}
              </p>
            )}
          </div>
        </li>
      );
    })
  }
</ul>

<style>
  .projects {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: var(--date-col) minmax(0, var(--measure));
    gap: 0 1.5rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--rule);
  }

  li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .year {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    padding-top: 0.2em;
  }

  h3 {
    margin: 0 0 0.25rem;
    font-size: var(--step-1);
  }

  p {
    margin: 0;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.25rem;
    margin-top: 0.4rem;
    font-size: var(--step--1);
    color: var(--muted);
  }

  @media (max-width: 30rem) {
    li {
      grid-template-columns: 1fr;
    }
  }
</style>
