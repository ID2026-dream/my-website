---
import { SITE } from '../site.config';
import { url } from '../utils';

const year = new Date().getFullYear();
---

<footer class="wrap">
  <p class="contact">
    Want to talk? Email me at <a class="mark" href={`mailto:${SITE.email}`}>{SITE.email}</a>
  </p>
  <ul>
    {
      SITE.links.map((link) => (
        <li>
          <a class="mark" href={link.href} rel="me">
            {link.label}
          </a>
        </li>
      ))
    }
    <li><a class="mark" href={url('/rss.xml')}>RSS</a></li>
  </ul>
  <p class="small">© {year} {SITE.name}</p>
</footer>

<style>
  footer {
    display: grid;
    gap: 0.75rem;
    padding-block: 2.5rem 3rem;
    border-top: 1px solid var(--rule);
  }

  p {
    margin: 0;
  }

  .contact {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .small {
    font-size: var(--step--1);
    color: var(--muted);
  }
</style>
