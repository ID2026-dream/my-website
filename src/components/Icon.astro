---
// Two-tone illustrated icons, drawn on a 48 × 48 grid.
// Each shape has a role: f = soft tinted fill, l = outline, s = solid,
// a = accent fill, al = accent outline. Colours come from `color` (the main
// tone, via currentColor) and `--icon-accent` (the highlight).
interface Props {
  name: string;
  size?: number;
  label?: string; // give a label if the icon carries meaning on its own
  // 'reveal': plays once when scrolled into view, and loops while its card is hovered
  // 'live': always moving (used for the single icon in each page header)
  // 'none': still
  animate?: 'reveal' | 'live' | 'none';
}

