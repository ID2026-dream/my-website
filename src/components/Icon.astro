// Translate the roles into SVG attributes so the icon works anywhere.
const ROLE: Record<string, string> = {
  f: 'fill="currentColor" fill-opacity="0.16"',
  l: 'fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"',
  s: 'fill="currentColor"',
  a: 'fill="var(--icon-accent, #e9a23b)"',
  al: 'fill="none" stroke="var(--icon-accent, #e9a23b)" stroke-linecap="round" stroke-linejoin="round"',
};
const body = (ICONS[name] ?? '').replace(/<(\w+) class="(\w+)"([^>]*)>/g, (_m, tag, role, rest) => {
  const needsWidth = (role === 'l' || role === 'al') && !/stroke-width=/.test(rest);
  return `<${tag} ${ROLE[role]}${needsWidth ? ' stroke-width="2.4"' : ''}${rest}>`;
});
---

<svg
  class:list={['ico', { live: animate === 'live' }]}
  data-reveal={animate === 'reveal' ? '' : undefined}
  width={size}
  height={size}
  viewBox="0 0 48 48"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>
