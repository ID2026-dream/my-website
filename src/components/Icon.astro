---
// Icons from open icon sets (see icon-data.ts for the sets and licences).
// Phosphor duotone icons take their main colour from `color` (currentColor)
// and the second tone from `--icon-accent`.
//
// `name` can be a full id such as 'ph:atom' or 'academicons:orcid', a
// Phosphor name on its own such as 'atom', or one of the short names the
// site used before (quantum, network, sensor, ...).
import { ICONS } from './icon-data';

interface Props {
  name: string;
  size?: number; // height in pixels; wide icons such as flags get wider
  label?: string; // give a label if the icon carries meaning on its own
  // 'reveal': plays once when scrolled into view, and loops while its card is hovered
  // 'live': always moving (used for the single icon in each page header)
  // 'none': still
  animate?: 'reveal' | 'live' | 'none';
}

const { name, size = 24, label, animate = 'reveal' } = Astro.props;

// The names used before the switch to Phosphor, so older content still works.
const LEGACY: Record<string, string> = {
  quantum: 'atom',
  network: 'cell-tower',
  sensor: 'circuitry',
  shield: 'shield-check',
  pulse: 'heartbeat',
  wave: 'wave-sine',
  person: 'user-circle',
  briefcase: 'briefcase',
  trophy: 'trophy',
  flask: 'flask',
  book: 'books',
  cap: 'graduation-cap',
  megaphone: 'megaphone',
  building: 'buildings',
  people: 'users-three',
  lock: 'lock-key',
  sun: 'sun',
  bolt: 'lightning',
  globe: 'globe-hemisphere-west',
  nodes: 'graph',
};

// How each icon moves as a whole. Anything not listed lifts gently.
const MOTION: Record<string, string> = {
  atom: 'spin',
  'gear-six': 'spin',
  'globe-hemisphere-west': 'spin',
  'globe-simple': 'spin',
  'circles-three': 'spin',
  spiral: 'spin',
  heartbeat: 'beat',
  brain: 'beat',
  'user-circle': 'beat',
  megaphone: 'swing',
  trophy: 'swing',
  anchor: 'swing',
  lightning: 'flash',
  sparkle: 'twinkle',
  sun: 'twinkle',
  wind: 'drift',
  tractor: 'drift',
  'wave-sine': 'drift',
  waveform: 'drift',
  waves: 'drift',
};

const id = name.includes(':') ? name : `ph:${LEGACY[name] ?? name}`;
let icon = ICONS[id];
if (!icon) {
  console.warn(`[Icon] There is no icon called "${name}". Showing the book icon instead. See src/components/icon-data.ts for the names.`);
  icon = ICONS['ph:books'];
}
const short = id.replace(/^ph:/, '');
const motion = id.startsWith('ph:') ? (MOTION[short] ?? 'lift') : undefined;
const width = Math.round((size * icon.width) / icon.height);
const body = motion ? `<g data-p="${motion}">${icon.body}</g>` : icon.body;
---

<svg
  class:list={['ico', { live: animate === 'live' }]}
  data-reveal={animate === 'reveal' && motion ? '' : undefined}
  width={width}
  height={size}
  viewBox={`0 0 ${icon.width} ${icon.height}`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={body}
/>
