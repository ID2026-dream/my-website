---
// A team member's photo from src/assets/team, or their initials until a
// photo is added. See src/assets/team/README.md for file names.
import type { ImageMetadata } from 'astro';
import { initials, photoSlug } from '../data/profile';

interface Props {
  name: string;
  size?: number;
}

const { name, size = 56 } = Astro.props;

const files = import.meta.glob<ImageMetadata>('../assets/team/*.{jpg,jpeg,png,webp}', {
  eager: true,
  import: 'default',
});
const slug = photoSlug(name);
const photo = Object.entries(files).find(([path]) => path.split('/').pop()!.replace(/\.[^.]+$/, '') === slug)?.[1];
---

{
  photo ? (
    <img class="team-photo" src={photo.src} alt="" width={size} height={size} loading="lazy" style={`--size:${size}px`} />
  ) : (
    <span class="team-photo initials" style={`--size:${size}px`} aria-hidden="true">
      {initials(name)}
    </span>
  )
}

<style>
  .team-photo {
    display: block;
    flex: none;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--signal);
  }

  .initials {
    display: grid;
    place-items: center;
    background: var(--navy);
    color: var(--on-navy);
    font-family: var(--display);
    font-size: calc(var(--size) * 0.36);
    font-weight: 520;
    letter-spacing: 0.02em;
  }
</style>
