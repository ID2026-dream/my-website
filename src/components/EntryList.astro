---
// A dated list used for career, awards, service and outreach.
import type { Entry } from '../data/profile';

interface Props {
  entries: Entry[];
  timeline?: boolean; // draw the vertical line and dots
}

const { entries, timeline = false } = Astro.props;
const dated = entries.some((e) => e.when);
---

<ol class:list={['entries', { timeline: timeline && dated, undated: !dated }]}>
  {
    entries.map((e) => (
      <li>
        {dated && <span class="when">{e.when}</span>}
        <div>
          <p class="what">{e.href ? <a href={e.href}>{e.what}</a> : e.what}</p>
          <p class="where">{e.where}</p>
          {e.note && <p class="note">{e.note}</p>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .entries {
    margin: 0;
    padding: 0;
    list-style: none;
    max-width: 48rem;
  }

  li {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr);
    gap: 0.25rem 1.5rem;
    padding-block: 1rem;
    border-top: 1px solid var(--rule);
  }

  li:last-child {
    border-bottom: 1px solid var(--rule);
  }

  .undated li {
    grid-template-columns: 1fr;
  }

  .timeline li {
    border-top: 0;
    border-bottom: 0;
    position: relative;
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: calc(9rem + 0.7rem);
    top: 0;
    bottom: 0;
    border-left: 2px solid var(--rule);
  }

  .timeline li::after {
    content: '';
    position: absolute;
    left: calc(9rem + 0.7rem - 4px);
    top: 1.45rem;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--link);
  }

  .timeline li > div {
    padding-left: 1rem;
  }

  @media (max-width: 36rem) {
    li {
      grid-template-columns: 1fr;
    }

    .timeline li::before,
    .timeline li::after {
      display: none;
    }

    .timeline li > div {
      padding-left: 0;
    }
  }

  .when {
    padding-top: 0.1rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--link);
  }

  p {
    margin: 0;
  }

  .what {
    font-weight: 650;
    line-height: 1.35;
  }

  .where {
    color: var(--muted);
  }

  .note {
    margin-top: 0.4rem;
    max-width: var(--measure);
  }
</style>
