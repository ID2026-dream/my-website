---
import Icon from './Icon.astro';
import type { Theme } from '../data/themes';
import { url } from '../utils';

interface Props {
  theme: Theme;
  count: number;
}

const { theme, count } = Astro.props;
const href = url(`/publications/?theme=${theme.id}`);
// amber tiles get a teal highlight so the accent still shows
const accent = theme.color === '#b86e0b' ? '#0b8783' : '#e9a23b';
---

<a class="card hover-anim" href={href} style={`--c:${theme.color};--icon-accent:${accent}`}>
  <span class="art"><Icon name={theme.icon} size={64} /></span>
  <span class="body">
    <span class="title">{theme.title}</span>
    <span class="summary">{theme.summary}</span>
    <span class="count">{count} {count === 1 ? 'publication' : 'publications'}</span>
  </span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition:
      transform 160ms ease,
      box-shadow 160ms ease,
      border-color 160ms ease;
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--c) 45%, var(--rule));
    box-shadow: 0 8px 20px -12px color-mix(in srgb, var(--c) 60%, transparent);
  }

  .art {
    display: grid;
    place-items: center;
    height: 7.5rem;
    color: var(--c);
    background:
      radial-gradient(circle at 50% 55%, color-mix(in srgb, var(--c) 14%, white) 0 2.6rem, transparent 2.65rem),
      linear-gradient(135deg, color-mix(in srgb, var(--c) 16%, white), color-mix(in srgb, var(--c) 5%, white));
    border-bottom: 1px solid color-mix(in srgb, var(--c) 18%, var(--rule));
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    padding: 1.1rem 1.25rem 1.2rem;
  }

  .title {
    font-size: 1.125rem;
    font-weight: 650;
    line-height: 1.25;
  }

  .summary {
    color: var(--muted);
    flex: 1;
  }

  .count {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--c);
  }

  .card:hover .count {
    text-decoration: underline;
  }
</style>
