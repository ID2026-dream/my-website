---
// A reading course in a list: icon panel, title, summary and short facts.
import Icon from './Icon.astro';
import type { Course } from '../data/courses';
import { url } from '../utils';

interface Props {
  course: Course;
  units: number;
  readings: number;
}

const { course, units, readings } = Astro.props;
const d = course.data;
const facts = [
  `${units} ${units === 1 ? 'unit' : 'units'}`,
  `${readings} ${readings === 1 ? 'reading' : 'readings'}`,
  ...d.facts,
];
---

<a class="card panel hover-anim" href={url(`/courses/${course.id}/`)} style={`--c:${d.color}`}>
  <span class="icon"><Icon name={d.icon} size={56} /></span>
  <span class="body">
    {d.level && <span class="level">{d.level}{d.draft && ' (draft)'}</span>}
    <span class="title">{d.title}</span>
    <span class="summary">{d.summary}</span>
    <span class="facts">{facts.map((f) => <span>{f}</span>)}</span>
  </span>
</a>

<style>
  .card {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    transition: border-color 0.2s, transform 0.2s;
  }

  .card:hover,
  .card:focus-visible {
    border-color: var(--c);
    transform: translateY(-2px);
  }

  .icon {
    display: grid;
    place-items: center;
    color: var(--c);
    background: linear-gradient(160deg, color-mix(in srgb, var(--c) 16%, white), color-mix(in srgb, var(--c) 6%, white));
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    padding: 1.1rem 1.25rem 1.25rem;
  }

  .level {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--c);
  }

  .title {
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 560;
    line-height: 1.2;
  }

  .summary {
    color: var(--muted);
  }

  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.35rem;
  }

  .facts span {
    padding: 0.15rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--rule);
    background: var(--paper);
    font-size: var(--step--1);
  }

  @media (max-width: 30rem) {
    .card {
      grid-template-columns: 1fr;
    }

    .icon {
      justify-items: start;
      padding: 1rem 1.25rem 0;
      background: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .card {
      transition: none;
    }

    .card:hover {
      transform: none;
    }
  }
</style>
