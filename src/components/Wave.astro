---
// An amplitude-modulated carrier: a quiet nod to signals and propagation.
// Drawn once at build time, so it costs nothing in the browser.
const W = 1200;
const H = 90;
const mid = H / 2;

function wave(carrier: number, envelope: number, phase: number, amp: number) {
  const pts: string[] = [];
  for (let x = 0; x <= W; x += 2) {
    const env = 0.25 + 0.75 * Math.abs(Math.sin((x / W) * Math.PI * envelope + phase));
    const y = mid + amp * env * Math.sin((x / W) * Math.PI * 2 * carrier + phase * 3);
    pts.push(`${x},${y.toFixed(2)}`);
  }
  return `M${pts.join(' L')}`;
}

const main = wave(30, 2.2, 0.3, 30);
const echo = wave(17, 1.4, 1.1, 22);
---

<svg class="wave" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" aria-hidden="true" focusable="false">
  <path d={echo} class="echo" />
  <path d={main} class="main" />
</svg>

<style>
  .wave {
    display: block;
    width: 100%;
    height: 72px;
  }

  path {
    fill: none;
    vector-effect: non-scaling-stroke;
  }

  .main {
    stroke: var(--signal);
    stroke-width: 1.5;
    opacity: 0.85;
  }

  .echo {
    stroke: var(--on-navy-muted);
    stroke-width: 1;
    opacity: 0.35;
  }
</style>
