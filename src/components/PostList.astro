---
import type { CollectionEntry } from 'astro:content';
import { formatDate, url } from '../utils';

interface Props {
  posts: CollectionEntry<'blog'>[];
}

const { posts } = Astro.props;
---

{
  posts.length === 0 ? (
    <p class="empty">No posts yet. Add a Markdown file to src/content/blog/ and it will appear here.</p>
  ) : (
    <ul class="posts">
      {posts.map((post) => (
        <li>
          <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, 'month')}</time>
          <div>
            <a class="mark" href={url(`/blog/${post.id}/`)}>
              {post.data.title}
            </a>
            {post.data.draft && <span class="draft"> (draft)</span>}
            <p>{post.data.description}</p>
          </div>
        </li>
      ))}
    </ul>
  )
}

<style>
  .posts {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    display: grid;
    grid-template-columns: var(--date-col) minmax(0, var(--measure));
    gap: 0 1.5rem;
    padding-block: 0.9rem;
  }

  time {
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }

  a {
    font-size: var(--step-1);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  p {
    margin: 0.15rem 0 0;
    color: var(--muted);
  }

  .draft {
    color: var(--muted);
  }

  @media (max-width: 30rem) {
    li {
      grid-template-columns: 1fr;
    }
  }
</style>
